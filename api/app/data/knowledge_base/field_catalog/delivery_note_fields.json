{
  "doc_type": "delivery_note",
  "description": "Delivery note / delivery order / packing list",
  "fields": [
    {"name": "delivery_note_number", "type": "string",  "required": true,  "validation_rule": "Non-empty alphanumeric identifier",
     "alternative_names": ["do_number", "do_no", "dn_number", "dn_no", "delivery_order_number", "delivery_no"]},
    {"name": "delivery_date",        "type": "date",    "required": false, "validation_rule": "Date in any recognisable format when printed; never invent"},
    {"name": "delivered_by",         "type": "string",  "required": true,  "validation_rule": "Non-empty string",
     "alternative_names": ["courier", "carrier", "driver", "transporter", "logistics_provider"]},
    {"name": "recipient_name",       "type": "string",  "required": false, "validation_rule": "Non-empty string",
     "alternative_names": ["ship_to", "deliver_to", "consignee", "receiver_name", "customer_name"]},
    {"name": "recipient_address",    "type": "string",  "required": false, "validation_rule": "Non-empty string"},
    {"name": "sender_name",          "type": "string",  "required": false, "validation_rule": "Non-empty string",
     "alternative_names": ["ship_from", "shipper", "from_name", "dispatch_from"]},
    {"name": "sender_address",       "type": "string",  "required": false, "validation_rule": "Non-empty string"},
    {"name": "items",                "type": "array",   "required": false, "validation_rule": "Array of objects with description and quantity"},
    {"name": "total_weight",         "type": "string",  "required": false, "validation_rule": "Non-empty string",
     "alternative_names": ["gross_weight", "weight", "net_weight", "package_weight"]},
    {"name": "notes",                "type": "string",  "required": false, "validation_rule": "Non-empty string",
     "alternative_names": ["remarks", "comments", "special_instructions", "instructions"]}
  ]
}
