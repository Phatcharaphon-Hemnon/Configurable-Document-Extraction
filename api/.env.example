APP_NAME=Configurable Document Extraction
APP_ENV=development
APP_HOST=localhost
APP_PORT=8000
APP_DEBUG=true
MAX_UPLOAD_MB=10
SUPPORTED_LANGUAGES=en,th
KNOWLEDGE_BASE_PATH=app/data/knowledge_base

# --- AI provider: 3 variables control everything ---
# LLM_PROVIDER: openai | xai | gemini | openrouter | deepseek | kimi
#               | ollama-cloud | ollama-local | mistral | openclaw | opencode
#               (base URL is automatic; see docs/ai_provider.md for key sources)
# LLM_API_KEY:  the only secret (ollama-local ignores it; falls back to the
#               provider's native key var, e.g. OPENAI_API_KEY, when empty)
# LLM_MODEL:    single model for Router + Extractor + Judge (defaults per
#               provider; REQUIRED for deepseek which ships no default).
# Change model/provider by editing these three lines only.
LLM_PROVIDER=ollama-cloud
LLM_API_KEY=
LLM_MODEL=gpt-oss:20b
# Copy-paste presets (keep one active block):
# OpenAI:      LLM_PROVIDER=openai     / LLM_MODEL=gpt-5.4-mini
# xAI:         LLM_PROVIDER=xai        / LLM_MODEL=grok-4
# Gemini:      LLM_PROVIDER=gemini     / LLM_MODEL=gemini-2.5-flash
# OpenRouter:  LLM_PROVIDER=openrouter / LLM_MODEL=openrouter/auto
# DeepSeek:    LLM_PROVIDER=deepseek   / LLM_MODEL=deepseek-v4-flash (required)
# Kimi:        LLM_PROVIDER=kimi       / LLM_MODEL=kimi-k2.6
# Mistral:     LLM_PROVIDER=mistral    / LLM_MODEL=mistral-large-latest
# OpenClaw:    LLM_PROVIDER=openclaw   / LLM_MODEL=openclaw/default
#              (local gateway; enable gateway.http.endpoints.chatCompletions)
# OpenCode:    LLM_PROVIDER=opencode   / LLM_MODEL=gpt-5.4-mini
#              (Zen gateway; key "public" serves free-tier models)
# Claude has no native entry (Messages API is not OpenAI-compatible) —
# reach it via openrouter or opencode.
# Optional: base-URL override (default per provider), per-stage model
# overrides (default: LLM_MODEL), sampling temperature (default per
# provider: 1.0 on ollama-cloud, 0.0 elsewhere).
# LLM_BASE_URL=   # e.g. https://api.moonshot.cn/v1 for Kimi China region
# ROUTER_MODEL_NAME=
# EXTRACTION_MODEL_NAME=
# JUDGE_MODEL_NAME=
# LLM_TEMPERATURE=
# VISION_MODEL_NAME is legacy/optional (pipeline is text-only via RapidOCR).
VISION_MODEL_NAME=
EXTRACTION_MAX_TOKENS=3000
LLM_REQUEST_TIMEOUT_SECONDS=45
# Shared across all agents; Ollama Free supports one active request.
LLM_MAX_CONCURRENT_REQUESTS=1
# KEEP unset: strict json_schema is the default tier except on providers
# without support (deepseek starts at json_object). Set true/false to force.
# (see api/scripts/time_gateway_modes.py). Transient stalls are handled by
# same-tier retry, not by skipping strict mode.
# DISABLE_STRICT_JSON_SCHEMA=


# --- Performance / token tuning ---
# Skip the Judge LLM call for clean extractions (completeness=100%, no errors,
# all confidences >= threshold). Big token + latency win.
JUDGE_SKIP_WHEN_CLEAN=true
JUDGE_SKIP_CONFIDENCE=0.85
# Router caps: output token ceiling + how much document text it sees.
ROUTER_MAX_TOKENS=400
ROUTER_TEXT_CHARS=2000
# In-memory OCR cache by file hash (duplicate uploads skip RapidOCR).
OCR_CACHE_ENABLED=true

# --- Token minimization ---
# Few-shot examples injected into extractor prompts (0 = OFF, cheapest)
FEW_SHOT_EXAMPLES_PER_DOC_TYPE=0

# --- Document parsing: local RapidOCR (no API key, no network) ---
# OCR_DPI: PDF render resolution (150-600, default 300).
OCR_DPI=300

# --- Langfuse LLM observability (optional; disabled when empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Temporal workflow (optional; in-process pipeline when false) ---
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=doc-extraction

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:5173
