APP_NAME=Configurable Document Extraction
APP_ENV=development
APP_HOST=localhost
APP_PORT=8000
APP_DEBUG=true
MAX_UPLOAD_MB=10
SUPPORTED_LANGUAGES=en,th
KNOWLEDGE_BASE_PATH=app/data/knowledge_base

# --- AI provider: OpenCode Zen (https://opencode.ai/zen) ---
# Free tier works with the literal key "public"; for higher limits sign in at
# https://opencode.ai/zen and paste your key.
# A SINGLE text model handles Router + Extractor + Judge (no vision needed).
OPENCODE_API_KEY=public
ROUTER_MODEL_NAME=nemotron-3.5-lightning-free
JUDGE_MODEL_NAME=nemotron-3.5-lightning-free
EXTRACTION_MODEL_NAME=nemotron-3.5-lightning-free
# VISION_MODEL_NAME is legacy/optional (pipeline is text-only via RapidOCR).
VISION_MODEL_NAME=
EXTRACTION_MAX_TOKENS=3000
LLM_REQUEST_TIMEOUT_SECONDS=45
# KEEP false: strict json_schema is the only mode returning parseable output
# (see api/scripts/time_gateway_modes.py). Transient stalls are handled by
# same-tier retry, not by skipping strict mode.
DISABLE_STRICT_JSON_SCHEMA=false


# --- Performance / token tuning ---
# Skip the Judge LLM call for clean extractions (completeness=100%, no errors,
# all confidences >= threshold). Big token + latency win.
JUDGE_SKIP_WHEN_CLEAN=true
JUDGE_SKIP_CONFIDENCE=0.85
# Router caps: output token ceiling + how much document text it sees.
ROUTER_MAX_TOKENS=400
ROUTER_TEXT_CHARS=2000
# In-memory OCR cache by file hash (duplicate uploads skip RapidOCR).
OCR_CACHE_ENABLED=true

# --- Token minimization ---
# Few-shot examples injected into extractor prompts (0 = OFF, cheapest)
FEW_SHOT_EXAMPLES_PER_DOC_TYPE=0

# --- Document parsing: local RapidOCR (no API key, no network) ---
# OCR_DPI: PDF render resolution (150-600, default 300).
OCR_DPI=300

# --- Langfuse LLM observability (optional; disabled when empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Temporal workflow (optional; in-process pipeline when false) ---
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=doc-extraction

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:5173
