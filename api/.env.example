# DEPLOYMENT: cloud/API-key (branch main).
# Intended mode: LLM_PROVIDER=ollama-cloud, LLM_MODEL=gpt-oss:20b.
# LLM_API_KEY stays EMPTY in this tracked template — paste a real key into
# the ignored api/.env (or provider-native key var, see docs/ai_provider.md).
# Fresh checkout: `cp api/.env.example api/.env`, then set the key.
# Switching branches never rewrites the ignored api/.env — if run_all.sh
# reports an intended/effective provider mismatch, edit api/.env manually or
# use a separate worktree per deployment (see README). Local Ollama users:
# see chore/eval-3b-combined-report.
APP_NAME=Configurable Document Extraction
APP_ENV=development
APP_HOST=localhost
APP_PORT=8000
APP_DEBUG=true
MAX_UPLOAD_MB=10
SUPPORTED_LANGUAGES=en,th
KNOWLEDGE_BASE_PATH=app/data/knowledge_base

# --- AI provider: 3 variables control everything ---
# LLM_PROVIDER: openai | xai | gemini | openrouter | deepseek | kimi
#               | ollama-cloud | ollama-local | mistral | nvidia | openclaw | opencode
#               | xkiro
#               (base URL is automatic; see docs/guides/ai_provider.md for key sources)
# LLM_API_KEY:  the only secret (ollama-local ignores it; falls back to the
#               provider's native key var, e.g. OPENAI_API_KEY, when empty)
# LLM_MODEL:    single model for Router + Extractor + Judge (defaults per
#               provider; REQUIRED for deepseek and xkiro, which ship no default).
# Change model/provider by editing these three lines only.
LLM_PROVIDER=ollama-cloud
LLM_API_KEY=
LLM_MODEL=gpt-oss:20b
# Copy-paste presets (keep one active block):
# OpenAI:      LLM_PROVIDER=openai     / LLM_MODEL=gpt-5.4-mini
# xAI:         LLM_PROVIDER=xai        / LLM_MODEL=grok-4
# Gemini:      LLM_PROVIDER=gemini     / LLM_MODEL=gemini-2.5-flash
# OpenRouter:  LLM_PROVIDER=openrouter / LLM_MODEL=openrouter/auto
# DeepSeek:    LLM_PROVIDER=deepseek   / LLM_MODEL=deepseek-v4-flash (required)
# Kimi:        LLM_PROVIDER=kimi       / LLM_MODEL=kimi-k2.6
# Mistral:     LLM_PROVIDER=mistral    / LLM_MODEL=mistral-large-latest
# Nvidia NIM:  LLM_PROVIDER=nvidia     / LLM_MODEL=meta/llama-3.3-70b-instruct
#              (key nvapi-... from Get API Key on any model at build.nvidia.com)
# OpenClaw:    LLM_PROVIDER=openclaw   / LLM_MODEL=openclaw/default
#              (local gateway; enable gateway.http.endpoints.chatCompletions)
# OpenCode:    LLM_PROVIDER=opencode   / LLM_MODEL=gpt-5.4-mini
#              (Zen gateway; key "public" serves free-tier models)
# xKiro:       LLM_PROVIDER=xkiro      / LLM_MODEL=<verified vendor/model ID> (required)
#              (gateway; key from https://xkiro.com/dashboard/api/keys; bare model
#              names 404 upstream — always send vendor/model, e.g. "openai/..."
#              pick a free-tier model verified via GET /v1/models; see
#              docs/guides/ai_provider.md — documented 2026-09-14, not live-verified)
# Claude has no native entry (Messages API is not OpenAI-compatible) —
# reach it via openrouter, opencode, or xkiro.
# Optional: base-URL override (default per provider), per-stage model
# overrides (default: LLM_MODEL), sampling temperature (default per
# provider: 1.0 on ollama-cloud, 0.0 elsewhere).
# LLM_BASE_URL=   # e.g. https://api.moonshot.cn/v1 for Kimi China region
# ROUTER_MODEL_NAME=
# EXTRACTION_MODEL_NAME=
# JUDGE_MODEL_NAME=
# LLM_TEMPERATURE=
# VISION_MODEL_NAME is legacy/optional (pipeline is text-only via RapidOCR).
VISION_MODEL_NAME=
EXTRACTION_MAX_TOKENS=3000
# Timeouts: one 45s request + 2s backoff + one 45s retry ≈ 92s fits inside the
# 100s Router/Judge limits (Extractor 150s allows the same retry plus the
# single corrective generation). Shorter limits bound failures; they do not
# accelerate model generation. A request timeout above a stage limit cancels
# before the retry can run — startup warns in that case.
LLM_REQUEST_TIMEOUT_SECONDS=45
ROUTER_TIMEOUT_SECONDS=100
EXTRACTOR_TIMEOUT_SECONDS=150
JUDGE_TIMEOUT_SECONDS=100
# Shared across all agents; Ollama Free supports one active request.
# Keep at one initially; one API process per account.
LLM_MAX_CONCURRENT_REQUESTS=1
# KEEP unset: strict json_schema is the default tier except on providers
# without support (deepseek starts at json_object). Set true/false to force.
# (see api/scripts/time_gateway_modes.py). Transient stalls are handled by
# same-tier retry, not by skipping strict mode.
# DISABLE_STRICT_JSON_SCHEMA=
# KEEP unset: reasoning-effort override for reasoning models on endpoints
# with a documented `reasoning_effort` parameter (NVIDIA NIM gpt-oss, xKiro
# per-model levels). Unset/empty preserves current behavior exactly. When set
# to low/medium/high/none it applies ONLY to exact verified (endpoint, model)
# pairs in the client's allowlist; all other providers/models ignore it.
# "none" is a per-model off-switch, not a universal one — an accepted request
# does NOT prove reasoning was disabled (some providers silently adjust
# unsupported levels). Recorded in logs and cache fingerprints.
# See docs/reports/nvidia_extractor_timeout_2026-09-14.md.
# LLM_REASONING_EFFORT=


# --- Performance / token tuning ---
# Skip the Judge LLM call for clean extractions (completeness=100%, no errors,
# all confidences >= threshold). Big token + latency win.
JUDGE_SKIP_WHEN_CLEAN=true
JUDGE_SKIP_CONFIDENCE=0.85
# Router caps: output token ceiling + how much document text it sees.
ROUTER_MAX_TOKENS=400
ROUTER_TEXT_CHARS=2000
# Project-local OCR cache (duplicate uploads skip OCR).
OCR_CACHE_ENABLED=true
# Persistent completed-result cache (SQLite under .cache, no Redis).
# force_refresh=true bypasses it per request (OCR cache stays on);
# disable_caches=true bypasses both (benchmark/debug).
RESULT_CACHE_ENABLED=true
RESULT_CACHE_TTL_SECONDS=604800
RESULT_CACHE_MAX_ENTRIES=128

# --- Token minimization ---
# Few-shot examples injected into extractor prompts (0 = OFF, cheapest)
FEW_SHOT_EXAMPLES_PER_DOC_TYPE=0

# --- Document parsing: local Thai/English OCR (no API key, no network) ---
# OCR_ENGINE: tesseract (default, eng+tha) | rapidocr (PP-OCRv5 TH, Thai+English)
#           | hybrid (opt-in: PP-OCRv5 TH→EN retry + TrOCR English handwriting).
# Tesseract stays the default while hybrid is benchmarked.
OCR_ENGINE=tesseract
OCR_LANGUAGES=eng+tha
OCR_TIMEOUT_SECONDS=120
# Optional overrides: TESSERACT_CMD, TESSDATA_DIR
# Hybrid selective retry (only when OCR_ENGINE=hybrid; CPU sequential):
# threshold = RapidOCR confidence below which English line crops are eligible.
# limit = at most N lowest-confidence eligible regions per page.
HYBRID_TROCR_CONF_THRESHOLD=0.80
HYBRID_TROCR_MAX_REGIONS=10
HYBRID_TROCR_MODEL=microsoft/trocr-base-handwritten
HYBRID_TROCR_REVISION=aff187bd81f8d73231cd3ed24b7857fcb10ae00e
# Runtime database and source paths resolve from the repository root.
DATABASE_PATH=data/extraction.db
SOURCE_STORAGE_PATH=data/sources
# OCR_DPI: PDF render resolution (150-600, default 300).
OCR_DPI=300

# --- Langfuse LLM observability (optional; disabled when empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Temporal workflow (optional; in-process pipeline when false) ---
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=doc-extraction

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:5173
