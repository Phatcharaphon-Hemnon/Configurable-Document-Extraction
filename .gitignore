# ==========================================
# Python / Backend Avoidances
# ==========================================
# Virtual environments
venv/
.venv/
env/
ENV/

# Python caching
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Local configuration & secrets
.env
.env.local

# ==========================================
# React Frontend Avoidances
# ==========================================
# Dependencies (Vercel will install this on its own)
web/node_modules/

# Production build artifacts
web/dist/
web/build/

# TypeScript build caches
web/*.tsbuildinfo

# Local dev/system files
web/.apps/
.DS_Store
Thumbs.db

# Ruff cache
.ruff_cache/
# Compiled vite config artifacts (tsc -b output)
web/vite.config.js
web/vite.config.d.ts

# Runtime documents, OCR installation, and database snapshots
.local/
data/extraction.db
data/extraction.db-wal
data/extraction.db-shm
data/sources/
data/backups/
data/logs/
*.db-wal
*.db-shm

# Project-owned caches and browser test outputs
.cache/
web/test-results/
web/playwright-report/

# Analysis tooling trash and intermediate files (retain the current graph,
# configuration, metadata, and fingerprints: .ua/knowledge-graph.json,
# .ua/config.json, .ua/meta.json, .ua/fingerprints.json)
.ua/.trash-*/
.ua/intermediate/
