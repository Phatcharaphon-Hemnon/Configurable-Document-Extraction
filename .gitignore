# ==========================================
# Python / Backend Avoidances
# ==========================================
# Virtual environments
venv/
.venv/
env/
ENV/

# Python caching
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Local configuration & secrets
.env
.env.local

# ==========================================
# React Frontend Avoidances
# ==========================================
# Dependencies (Vercel will install this on its own)
apps/web/node_modules/

# Production build artifacts
apps/web/dist/
apps/web/build/

# TypeScript build caches
apps/web/*.tsbuildinfo

# Local dev/system files
apps/web/.apps/
.DS_Store
Thumbs.db

# Ruff cache
.ruff_cache/