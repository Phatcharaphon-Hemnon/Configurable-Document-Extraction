APP_NAME=Configurable Document Extraction
APP_ENV=development
APP_HOST=localhost
APP_PORT=8000
APP_DEBUG=true
MAX_UPLOAD_MB=10
SUPPORTED_LANGUAGES=en,th
SUPPORTED_DOC_TYPES=invoice,po,delivery_note
KNOWLEDGE_BASE_PATH=app/data/knowledge_base
FEW_SHOT_EXAMPLES_PER_DOC_TYPE=5
GITHUB_MODELS_TOKEN=
ROUTER_MODEL_NAME=gpt-4.1
JUDGE_MODEL_NAME=gpt-4.1
RECOMMENDED_EXTRACTION_MODEL_NAME=gpt-4.1
RECOMMENDED_EXTRACTION_MODEL_DISPLAY_NAME=GPT-4.1 (GitHub Models)
RECOMMENDED_EXTRACTION_MODEL_REASON=gpt-4.1 is free under GitHub Student Pack / Copilot Pro and not metered against premium request quota.
ENABLE_SEMANTIC_FIELD_MATCHING=true
FIELD_EMBEDDING_MODEL_NAME=text-embedding-3-small
FIELD_EMBEDDING_SIMILARITY_THRESHOLD=0.80
FIELD_EMBEDDING_CACHE_PATH=app/data/cache/field_embedding_cache.json
LLAMA_CLOUD_API_KEY=
