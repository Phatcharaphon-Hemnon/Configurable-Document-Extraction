APP_NAME=Configurable Document Extraction
APP_ENV=development
APP_HOST=localhost
APP_PORT=8000
APP_DEBUG=true
MAX_UPLOAD_MB=10
SUPPORTED_LANGUAGES=en,th
SUPPORTED_DOC_TYPES=invoice,po,delivery_note
KNOWLEDGE_BASE_PATH=app/data/knowledge_base
FEW_SHOT_EXAMPLES_PER_DOC_TYPE=5
NVIDIA_API_KEY=
ROUTER_MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
JUDGE_MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
RECOMMENDED_EXTRACTION_MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
RECOMMENDED_EXTRACTION_MODEL_DISPLAY_NAME=NVIDIA Nemotron 3 Nano Omni (NVIDIA API, reasoning)
RECOMMENDED_EXTRACTION_MODEL_REASON=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning is a reasoning-capable multimodal model via NVIDIA NIM API. Reasoning is disabled for structured-output pipeline calls.
EXTRACTION_MAX_TOKENS=8000
ENABLE_SEMANTIC_FIELD_MATCHING=true
FIELD_EMBEDDING_MODEL_NAME=text-embedding-3-small
FIELD_EMBEDDING_SIMILARITY_THRESHOLD=0.80
FIELD_EMBEDDING_CACHE_PATH=app/data/cache/field_embedding_cache.json
# Per-attempt timeout (seconds) for LLM calls. Increase if vision models are slow.
LLM_REQUEST_TIMEOUT_SECONDS=90
# Set to true to skip strict JSON schema enforcement (for models that reject/mishandle strict: true)
DISABLE_STRICT_JSON_SCHEMA=false
LLAMA_CLOUD_API_KEY=
