{
  "doc_type": "po",
  "description": "Purchase order",
  "fields": [
    {"name": "po_number",       "type": "string",  "required": true,  "validation_rule": "Non-empty alphanumeric identifier",
     "alternative_names": ["po_no", "po_id", "purchase_order_number", "order_number", "order_no"]},
    {"name": "order_date",      "type": "date",    "required": true,  "validation_rule": "Date in any recognisable format",
     "alternative_names": ["po_date", "issue_date", "date", "purchase_date"]},
    {"name": "supplier_name",   "type": "string",  "required": true,  "validation_rule": "Non-empty string",
     "alternative_names": ["vendor_name", "seller_name", "merchant_name", "from_name"]},
    {"name": "supplier_address","type": "string",  "required": false, "validation_rule": "Non-empty string"},
    {"name": "buyer_name",      "type": "string",  "required": false, "validation_rule": "Non-empty string",
     "alternative_names": ["ship_to", "bill_to", "to_name", "customer_name", "purchaser_name"]},
    {"name": "buyer_address",   "type": "string",  "required": false, "validation_rule": "Non-empty string"},
    {"name": "delivery_date",   "type": "date",    "required": false, "validation_rule": "Date in any recognisable format"},
    {"name": "total_amount",    "type": "number",  "required": true,  "validation_rule": "Positive numeric value",
     "alternative_names": ["grand_total", "total", "order_total", "net_total"]},
    {"name": "currency",        "type": "string",  "required": true,  "validation_rule": "ISO 4217 code or symbol"},
    {"name": "payment_terms",   "type": "string",  "required": false, "validation_rule": "Non-empty string",
     "alternative_names": ["terms", "pay_terms", "net_terms"]},
    {"name": "line_items",      "type": "array",   "required": false, "validation_rule": "Array of objects with description, quantity, unit_price, total"},
    {"name": "notes",           "type": "string",  "required": false, "validation_rule": "Non-empty string"}
  ]
}
