APP_NAME=Configurable Document Extraction
APP_ENV=development
APP_HOST=localhost
APP_PORT=8000
APP_DEBUG=true
MAX_UPLOAD_MB=10
SUPPORTED_LANGUAGES=en,th
KNOWLEDGE_BASE_PATH=app/data/knowledge_base

# --- AI provider (OpenAI-compatible; NVIDIA NIM or OpenRouter) ---
# NVIDIA_API_KEY is tried first, falls back to OPENROUTER_API_KEY
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ROUTER_MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
JUDGE_MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
EXTRACTION_MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
EXTRACTION_MAX_TOKENS=4000
LLM_REQUEST_TIMEOUT_SECONDS=90
DISABLE_STRICT_JSON_SCHEMA=false

# --- Token minimization ---
# Few-shot examples injected into extractor prompts (0 = OFF, cheapest)
FEW_SHOT_EXAMPLES_PER_DOC_TYPE=0

# --- Document parsing (OCR path for PDFs; images skip this) ---
LLAMA_CLOUD_API_KEY=

# --- Langfuse LLM observability (optional; disabled when empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Temporal workflow (optional; in-process pipeline when false) ---
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=doc-extraction

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:5173
