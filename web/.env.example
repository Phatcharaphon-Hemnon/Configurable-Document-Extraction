# Base URL of the FastAPI backend.
#
# This value is PUBLIC by design — it is compiled into the browser bundle and
# contains no secrets. On Vercel, add it as a NORMAL environment variable
# (leave the "Sensitive" checkbox UNCHECKED, otherwise Vercel rejects the
# VITE_ prefix).
#
# - Local dev:      leave this file without a value — the Vite dev proxy
#                   forwards /api to http://127.0.0.1:8000 automatically.
# - Production:     set it to your backend's public URL, e.g.
#                   VITE_API_BASE_URL=https://your-backend.onrender.com/api
#
# NEVER put secrets (API keys, tokens) behind the VITE_ prefix — anything in
# VITE_* is visible to every visitor of the site.
VITE_API_BASE_URL=
