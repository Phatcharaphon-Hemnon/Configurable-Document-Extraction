{
  "generic": {
    "invoice_number": [
      "\\b(?:inv(?:oice)?|statement)\\s*[#:\-]?\\s*([A-Za-z0-9-]+)\\b",
      "\\binvoice[_ ]?no[_ ]?[:#]?\\s*([A-Za-z0-9-]+)\\b"
    ],
    "total_amount": [
      "(?:total|balance|amount|balance due)[:\s]*([\\$PHP|USD|THB|EUR|RM|£]?\\s*[+-]?\\d{1,3}(?:[,\\s]\d{3})*(?:\\.\\d+)?)"
    ],
    "currency": [
      "\\b(PHP|USD|THB|EUR|RM|GBP|\\$|£)\\b"
    ],
    "statement_date": [
      "\\b(?:statement date|date)[:\s]*([0-3]?\\d[\\/\\-][0-3]?\\d[\\/\\-](?:\\d{2,4}))\\b",
      "\\b(\\d{4}-\\d{2}-\\d{2})\\b"
    ],
    "customer_id": [
      "\\b(?:customer|cust)\\s*(?:id|no|#)[:\s]*([A-Za-z0-9-]+)\\b"
    ],
    "vendor_email": [
      "([\\w\\.-]+@[\\w\\.-]+\\.[A-Za-z]{2,})"
    ],
    "vendor_phone": [
      "(\\+?\\d[\\d\\-\\s()]{6,}\\d)"
    ]
  }
}
