    {"name": "delivered_by",         "type": "string",  "required": true,  "validation_rule": "Non-empty string"},
    {"name": "recipient_name",       "type": "string",  "required": false, "validation_rule": "Non-empty string"},
    {"name": "recipient_address",    "type": "string",  "required": false, "validation_rule": "Non-empty string"},
    {"name": "sender_name",          "type": "string",  "required": false, "validation_rule": "Non-empty string"},
    {"name": "sender_address",       "type": "string",  "required": false, "validation_rule": "Non-empty string"},
    {"name": "items",                "type": "array",   "required": false, "validation_rule": "Array of objects with description and quantity"},
    {"name": "total_weight",         "type": "string",  "required": false, "validation_rule": "Non-empty string"},
