{
  "doc_type": "invoice",
  "description": "Tax invoice / sales invoice / POS receipt",
  "fields": [
    {"name": "invoice_number",   "type": "string",  "required": true,  "validation_rule": "Non-empty alphanumeric identifier"},
    {"name": "invoice_date",     "type": "date",    "required": true,  "validation_rule": "Date in any recognisable format"},
    {"name": "seller_name",      "type": "string",  "required": true,  "validation_rule": "Non-empty string"},
    {"name": "total_amount",     "type": "number",  "required": true,  "validation_rule": "Positive numeric value"},
    {"name": "bill_to_name",     "type": "string",  "required": false, "validation_rule": "Non-empty string"},
    {"name": "bill_to_address",  "type": "string",  "required": false, "validation_rule": "Non-empty string"},
    {"name": "seller_address",   "type": "string",  "required": false, "validation_rule": "Non-empty string"},
    {"name": "seller_phone",     "type": "string",  "required": false, "validation_rule": "Valid phone number"},
    {"name": "seller_email",     "type": "string",  "required": false, "validation_rule": "Valid email address"},
    {"name": "tax_id",           "type": "string",  "required": false, "validation_rule": "Non-empty tax identification number"},
    {"name": "currency",         "type": "string",  "required": false, "validation_rule": "ISO 4217 code or symbol (PHP, USD, THB, EUR …)"},
    {"name": "payment_due_date", "type": "date",    "required": false, "validation_rule": "Date in any recognisable format"},
    {"name": "subtotal_amount",  "type": "number",  "required": false, "validation_rule": "Positive numeric value"},
    {"name": "tax_amount",       "type": "number",  "required": false, "validation_rule": "Numeric value"},
    {"name": "paid_amount",      "type": "number",  "required": false, "validation_rule": "Positive numeric value"},
    {"name": "change_amount",    "type": "number",  "required": false, "validation_rule": "Numeric value"},
    {"name": "line_items",       "type": "array",   "required": false, "validation_rule": "Array of objects with description, quantity, unit_price, amount"}
  ]
}
