": "score_against_index", "summary": "Scores a single pre-indexed document entry against a query string using the same TF-IDF weighting as the in-memory ranker.", "tags": ["scoring", "tf-idf", "retrieval", "index"], "type": "function"}, {"complexity": "moderate", "id": "function:api/scripts/ingest_kb.py:ingest", "lineRange": [41, 82], "name": "ingest", "summary": "Reads few-shot examples and field-catalog counts from a KB directory, builds the TF-IDF index, and returns the index plus source inventory report.", "tags": ["ingestion", "indexing", "knowledge-base", "inventory"], "type": "function"}, {"complexity": "moderate", "id": "function:api/scripts/ingest_kb.py:main", "lineRange": [85, 118], "name": "main", "summary": "CLI entry point parsing --kb and --json flags, running ingest, writing rag_index.json, and printing per-doc-type ingestion counts.", "tags": ["entry-point", "cli", "ingestion", "indexing"], "type": "function"}, {"complexity": "simple", "id": "function:api/tests/test_rag_retriever.py:test_build_index_and_score_roundtrip", "lineRange": [53, 62], "name": "test_build_index_and_score_roundtrip", "summary": "Verifies build_index produces document frequencies and that score_against_index ranks the lexically matching example highest.", "tags": ["test", "indexing", "scoring", "retrieval"], "type": "function"}, {"complexity": "moderate", "id": "function:api/tests/test_rag_retriever.py:test_ingest_reads_real_kb_layout", "lineRange": [65, 86], "name": "test_ingest_reads_real_kb_layout", "summary": "Builds a synthetic KB directory with few-shot, catalog, ground-truth, and PDF files and asserts ingest reports correct counts and filenames.", "tags": ["test", "ingestion", "knowledge-base", "integration"], "type": "function"}]}